{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci",
  "outputDirectory": ".",
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    }
  }
}
